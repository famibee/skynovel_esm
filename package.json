{
	"name": "@famibee/skynovel_esm",
	"version": "2.2.0",
	"description": "webgl novelgame framework",
	"author": "miyazawa famibee",
	"publisher": "famibee",
	"homepage": "http://famibee.blog38.fc2.com/",
	"license": "MIT",
	"main": "./dist/web.js",
	"types": "./dist/web.d.ts",
	"type": "module",
	"files": [
		"dist",
		"dist_app"
	],
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/web.d.ts",
			"default": "./dist/web.js"
		},
		"./web": {
			"types": "./dist/web.d.ts",
			"default": "./dist/web.js"
		},
		"./appMain": {
			"types": "./dist/appMain.d.ts",
			"default": "./dist_app/appMain.js"
		},
		"./preload": {
			"types": "./dist/preload.d.ts",
			"default": "./dist_app/preload.js"
		},
		"./app": {
			"types": "./dist/app.d.ts",
			"default": "./dist_app/app.js"
		}
	},
	"dependencies": {
		"adm-zip": "^0.6.0",
		"electron-store": "^11.0.2",
		"fs-extra": "^11.4.0",
		"motion": "^13.1.1",
		"pixi.js": "^6.5.10"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.11.12",
		"@playwright/test": "^1.62.1",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.4.0",
		"@typescript/typescript6": "^6.0.2",
		"electron": "^44.0.0",
		"eslint": "^10.9.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^29.16.5",
		"globals": "^17.11.0",
		"jiti": "^2.7.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2"
	},
	"scripts": {
		"build": "bun src/build.ts",
		"watch": "bun --watch src/build.ts --watch",
		"update": "bun update && bun watch && ncu -g",
		"test": "bun test --only-failures",
		"testw": "bun test --only-failures --watch",
		"test:e2e": "playwright test -c test/e2e",
		"test:e2e:ui": "playwright test -c test/e2e --ui",
		"docs": "vite docs/ --open /tag.html",
		"rebuild": "bun pm cache rm && bun watch"
	},
	"keywords": [
		"novelgame",
		"visualnovel",
		"skynovel",
		"esm",
		"webgl",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/famibee/skynovel_esm.git"
	},
	"publishConfig": {
		"scope": "@famibee",
		"tag": "latest",
		"access": "public",
		"provenance": true
	},
	"bugs": {
		"url": "https://github.com/famibee/skynovel_esm/issues",
		"email": "famibee@gmail.com"
	}
}
